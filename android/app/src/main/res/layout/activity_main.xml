<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="top">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery Voice"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identity"
        android:textSize="13sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. rider_001"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNext"
        android:singleLine="true"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery ID"
        android:textSize="13sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDeliveryId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. DEL-20240603-001"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:singleLine="true"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnDial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dial"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnDialIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Accept"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvConferenceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:layout_marginBottom="32dp"/>

    <!-- Call controls — shown only during a call -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mute"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnHangup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hang Up"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
